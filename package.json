{
  "name": "whooper",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for the Whooper API platform.",
  "license": "ISC",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "bunx turbo run build",
    "dev": "bunx turbo run dev --parallel",
    "start": "bunx turbo run start --parallel",
    "dev:engine": "bunx turbo run dev --filter=@whooper/engine",
    "dev:api": "bunx turbo run dev --filter=@whooper/api",
    "dev:frontend": "bunx turbo run dev --filter=@whooper/frontend",
    "start:engine": "bunx turbo run start --filter=@whooper/engine",
    "start:api": "bunx turbo run start --filter=@whooper/api",
    "start:frontend": "bunx turbo run start --filter=@whooper/frontend"
  },
  "devDependencies": {
    "turbo": "^2.6.3"
  },
  "packageManager": "bun@1.3.7",
  "engines": {
    "bun": ">=1.3.7"
  },
  "dependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/connect": "^3.4.38",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/http-errors": "^2.0.5",
    "@types/mime": "^4.0.0",
    "@types/qs": "^6.15.1",
    "@types/range-parser": "^1.2.7",
    "@types/send": "^1.2.1",
    "@types/serve-static": "^2.2.0",
    "@types/strip-bom": "^4.0.1",
    "@types/strip-json-comments": "^3.0.0"
  }
}
