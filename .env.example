# Shared monorepo env.
# Keep the real .env file at the repository root so apps can read common config.

# apps/engine
REDIS_URL=redis://localhost:6379
DB_URL=postgres://postgres:postgres@localhost:5432/whooper
ENGINE_PORT=3000
LOG_LEVEL=info

# apps/api
API_PORT=3001

# apps/frontend
FRONTEND_PORT=3002
